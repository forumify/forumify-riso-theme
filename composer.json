{
    "name": "forumify/forumify-riso-theme",
    "description": "A risograph print zine: fluorescent inks, misregistered offset shadows and paper grain.",
    "type": "forumify-theme",
    "license": "OSL-3.0",
    "require": {
        "php": ">=8.4",
        "forumify/forumify-platform": "^1.3",
        "forumify/forumify-theme": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "Forumify\\RisoTheme\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "lock": false
    },
    "extra": {
        "forumify-plugin-class": "Forumify\\RisoTheme\\RisoTheme"
    },
    "homepage": "https://forumify.net"
}
